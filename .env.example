# Supply these through university-managed secrets/environment configuration.
# .env is not automatically loaded. Never commit secrets or paste them in chat.
TRACKER_ORIGIN=https://accreditation.example.northwestu.edu
ENTRA_TENANT_ID=replace-with-university-directory-tenant-guid
ENTRA_CLIENT_ID=replace-with-application-client-guid
ENTRA_CLIENT_SECRET=replace-via-secret-manager
# Object ID of admin@northwestu.edu (Entra > Users > user > Overview)
ENTRA_ADMIN_OBJECT_ID=replace-with-user-object-guid
HOST=127.0.0.1
PORT=8000

ENTRA_ADMIN_EMAIL=admin@northwestu.edu
